generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STARTER
  SUBSTITUTE
  COACH
}

model Season {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  year       Int
  createdAt DateTime @default(now())
  sourceUrl String?
  sourcedAt DateTime?
  rosters   Roster[]
}

model Organization {
  id      String   @id @default(cuid())
  name    String   @unique
  region  String
  rosters Roster[]
}

model Person {
  id       String        @id @default(cuid())
  handle   String        @unique
  fullName String?
  country  String?
  photoUrl String? // Only store portraits with a usable license/permission.
  ratings  RosterMember[]
}

model Roster {
  id             String         @id @default(cuid())
  seasonId       String
  organizationId String
  placement      Int
  rankingPoints  Int?
  sourceUrl      String?
  sourcedAt      DateTime?
  season         Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        RosterMember[]

  @@unique([seasonId, organizationId])
}

model RosterMember {
  id       String @id @default(cuid())
  rosterId String
  personId String
  role     Role
  rating   Int    // validated in application/API: 0–100
  roster   Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id])

  @@unique([rosterId, personId, role])
}

model UserProgress {
  id        String   @id @default(cuid())
  userKey   String   @unique // replace with an auth-provider user ID later
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anonymous ranked identity, keyed by a random ID generated client-side and stored in
// localStorage (see PLAYER_KEY_STORAGE_KEY) -- same "replace with real auth later" pattern
// as UserProgress.userKey above.
model PlayerIdentity {
  id                String   @id @default(cuid())
  playerKey         String   @unique
  displayName       String
  isBot             Boolean  @default(false)
  mmr               Int      @default(600)
  wins              Int      @default(0)
  losses            Int      @default(0)
  lastTeamPower     Float?
  lastTeamSummary   String? // JSON: [{handle, rating, role}] snapshot shown to whoever gets matched against this player
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  matchesAsChallenger Match[] @relation("Challenger")
  matchesAsOpponent   Match[] @relation("Opponent")
}

model Match {
  id              String   @id @default(cuid())
  challengerId    String
  opponentId      String
  challenger      PlayerIdentity @relation("Challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent        PlayerIdentity @relation("Opponent", fields: [opponentId], references: [id], onDelete: Cascade)
  challengerPower Float
  opponentPower   Float
  challengerWon   Boolean
  score           String
  mmrDelta        Int
  playedAt        DateTime @default(now())
}

// Real (email + password) accounts -- separate from the anonymous, device-key-based
// PlayerIdentity used by Ranked 1v1. Profile/Friends/Friendly Battles all key off this.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String // scrypt hash, see lib/auth.ts
  passwordSalt    String
  displayName     String
  avatarEmoji     String   @default("🚀")
  avatarColor     String   @default("#ffcf49")
  avatarImage     String? // data: URI (png/jpeg/webp, client-resized to <=256px, size-capped server-side); takes visual priority over avatarEmoji/avatarColor when set
  lastTeamPower   Float?
  lastTeamSummary String? // JSON: {roster:[{handle,rating,role}], org} -- same shape as PlayerIdentity, revealed to friends during a Friendly Battle draft
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  sentRequests     Friendship[] @relation("Requester")
  receivedRequests Friendship[] @relation("Addressee")
}

// The cookie holds the raw token; only its SHA-256 is stored here, so a DB leak alone
// doesn't hand over live sessions (same principle as storing hashed API keys).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

// A casual, no-MMR-impact duel against a friend -- just a head-to-head record for bragging rights.
model FriendlyMatch {
  id            String   @id @default(cuid())
  hostId        String
  opponentId    String
  hostPower     Float
  opponentPower Float
  hostWon       Boolean
  score         String
  playedAt      DateTime @default(now())
}

// Submissions from the public /kontakt form -- see app/api/contact/route.ts. Nothing here is
// emailed out automatically yet (no email provider is configured); an operator reads these
// directly, e.g. via `npx prisma studio`.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String
  message   String
  createdAt DateTime @default(now())
}
