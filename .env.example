
# Postgres connection string (e.g. from Vercel Storage -> Create Database -> Postgres, or the
# POSTGRES_PRISMA_URL value from a Vercel Postgres/Neon integration). SQLite ("file:./dev.db")
# doesn't work once deployed: serverless functions don't share a persistent filesystem.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Required only for `npm run catalog:fetch`. Must identify a real contact per Liquipedia's API etiquette.
LIQUIPEDIA_USER_AGENT="RocketLeagueDraft/1.0 (you@example.com)"
